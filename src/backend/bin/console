#!/usr/bin/env php
<?php

use Albert\Core\Console\Commands\MakeControllerCommand;
use Albert\Core\Console\Commands\RouteListCommand;
use Symfony\Component\Console\Application;

$kernel = require __DIR__ . '/../bootstrap.php';

$app = new Application('Albert Framework', 'dev');
$app->add(new MakeControllerCommand(__DIR__ . '/../../app/Http/Controllers'));
$app->add(new RouteListCommand($kernel->router()));
$app->run();
